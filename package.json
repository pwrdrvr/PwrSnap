{
  "name": "pwrsnap-workspace",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Screen capture with a local-first library",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright © 2026 PwrDrvr LLC",
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.mjs",
    "build": "pnpm --filter @pwrsnap/desktop build",
    "dev": "pnpm --filter @pwrsnap/desktop dev",
    "design": "npx --yes serve design -l 4321",
    "rebuild:electron-native": "pnpm --filter @pwrsnap/desktop rebuild:electron-native",
    "typecheck": "pnpm -r --if-present typecheck",
    "deps:check": "node ./scripts/check-dependency-version-policy.mjs",
    "deps:sync": "node ./scripts/sync-packaged-electron-version.mjs",
    "metadata:check": "node ./scripts/check-app-metadata-policy.mjs",
    "fuses:check": "node ./scripts/check-electron-fuses-policy.mjs",
    "licenses:allowlist": "node ./scripts/check-third-party-license-allowlist.mjs",
    "licenses:check": "node ./scripts/check-package-license-policy.mjs && node ./scripts/check-third-party-license-allowlist.mjs && node ./scripts/generate-third-party-licenses.mjs --check",
    "licenses:generate": "node ./scripts/generate-third-party-licenses.mjs",
    "lint:colors": "node ./scripts/lint-renderer-colors.mjs",
    "settings-store:check": "node ./scripts/check-settings-store-boundary.mjs",
    "lint": "pnpm deps:check && pnpm metadata:check && pnpm fuses:check && pnpm typecheck && pnpm licenses:check && pnpm settings-store:check && pnpm lint:colors && pnpm lint:syntax && pnpm lint:typed",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:desktop-e2e": "pnpm --filter @pwrsnap/desktop build && pnpm --filter @pwrsnap/desktop test:e2e",
    "test:desktop-e2e:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/e2e/run-windows.ps1",
    "test:desktop-e2e:docker": "./scripts/e2e/run-docker.sh",
    "release:check": "node ./scripts/check-desktop-release-metadata.mjs",
    "fix:linux-sandbox": "node ./scripts/linux-sandbox.mjs --fix",
    "check:linux-sandbox": "node ./scripts/linux-sandbox.mjs --warn",
    "lint:syntax": "oxlint --config .oxlintrc.json apps packages scripts vitest.workspace.ts .pnpmfile.cjs .pnpmfile-global.cjs",
    "lint:typed": "node ./scripts/lint-typed.mjs",
    "typecheck:legacy": "pnpm -r --if-present typecheck:legacy",
    "check:benchmark": "node ./scripts/benchmark-dev-checks.mjs",
    "check:changed": "node ./scripts/check-changed.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "jsdom": "^29.0.2",
    "oxc-parser": "0.153.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^4.1.11"
  }
}
